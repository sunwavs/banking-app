# Copy to .env and fill in. The .env file is excluded from git.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=Bank
DB_POOL_MAX=10
# Time zone of the database session: defines the boundaries of calendar months in reports.
DB_TIMEZONE=UTC

# Redis (product catalog cache). CACHE_ENABLED=false disables the cache entirely.
CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=10

# Sessions. Use false for local development over http; use true in production (HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=30

# Login attempt limit (per client address). With several workers use a shared storage,
# for example redis://127.0.0.1:6379/1
LOGIN_RATE_LIMIT=10 per minute
RATELIMIT_STORAGE_URI=memory://

# Number of reverse proxies in front of the application (0 = none). Needed for the login
# rate limit to see the real client address.
PROXY_HOPS=0

LOG_LEVEL=INFO
